#!/bin/sh
# redbug remote tracing needs distributed Erlang with fully-qualified (long)
# node names so the controller can reach a `name@host` target node.
# REDBUG_DIST=off boots the release without distribution (see Server.Dist).
if [ "${REDBUG_DIST:-}" = off ]; then
  export RELEASE_DISTRIBUTION=none
else
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
  export RELEASE_NODE="${RELEASE_NODE:-redbug_controller@127.0.0.1}"
fi
