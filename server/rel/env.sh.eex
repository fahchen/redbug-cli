#!/bin/sh
# The release boots with no distribution. Server.Application starts it after the
# app loads (CONTROLLER_NODE, default redbug_controller@127.0.0.1), because the
# connect-only epmd shim Server.Epmd loads only with the app: pinned endpoints
# (REDBUG_NODES / SSH tunnels) dial direct, unpinned names fall back to real
# epmd. REDBUG_DIST=off starts no distribution, so it needs no epmd flags (see
# Server.Dist).
export RELEASE_DISTRIBUTION=none
if [ "${REDBUG_DIST:-}" != off ]; then
  export ERL_FLAGS="-start_epmd false -epmd_module Elixir.Server.Epmd${ERL_FLAGS:+ $ERL_FLAGS}"
fi
