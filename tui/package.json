{
  "name": "redbug-tui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/index.tsx",
    "build:redbug": "bun build --compile src/main.tsx --outfile ../dist/redbug",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@musubi/client": "workspace:*",
